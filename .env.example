# ---------------------------------------------------------------------------
# CourseKit — environment definitions (single source of truth)
# Every phase of the project reuses these exact variable names.
# Copy to .env / .env.local and fill real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Infrastructure (scaffold) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Frontend phase (Prompt 1) ---
# Explicit opt-in to mock service adapters. NEVER enable in real production.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend phase (Prompt 5) — defined now, wired later ---
# Supabase Auth + PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL="CourseKit <hello@example.com>"

# Cloudflare R2 storage (course media delivery)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
