# ---------- Core ----------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# openssl rand -base64 32
ENCRYPTION_KEY=""
# openssl rand -hex 32   (Vercel Cron sends it as Bearer to the job endpoints)
CRON_SECRET=""

# ---------- Demo conveniences (set all to false for real launches) ----------
DEMO_SEED="true"
ALLOW_DEMO_BILLING="true"
ALLOW_SIMULATED_CONNECTIONS="true"
ALLOW_LOCAL_UPLOADS="true"

# ---------- Email (choose one) ----------
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_FROM="Beevo <hello@yourdomain.com>"

# ---------- Razorpay (INR billing) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- OAuth apps (per platform) ----------
GOOGLE_CLIENT_ID=""            # YouTube
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""                 # Facebook + Instagram
META_APP_SECRET=""
X_CLIENT_ID=""                 # Twitter / X
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# ---------- Storage & AI (optional) ----------
