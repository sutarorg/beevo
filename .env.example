# ==============================================================================
# Beevo Production & Staging Environment Configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# ==============================================================================

# --- Public App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (PostgreSQL + Auth SSR + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY: NEVER expose with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OpenAI (Responses API — Script & Dynamic Storyboard) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_STORY_MODEL=gpt-4o-mini
OPENAI_STORYBOARD_MODEL=gpt-4o

# --- fal.ai (Image Generation ONLY — Character Sheets & Scene Illustrations) ---
FAL_KEY=your-fal-api-key
FAL_IMAGE_MODEL=blackforestlabs/flux-3/klein/text-to-image
FAL_EDIT_MODEL=blackforestlabs/flux-3/klein/edit-image
FAL_WEBHOOK_SECRET=your-fal-webhook-shared-secret

# --- ElevenLabs (Narration TTS + Character Alignment Timestamps) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2

# --- Cloudflare R2 (Private S3-Compatible Object Storage) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=beevo-media-private
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# --- Razorpay (One-Time INR Credit Packs + Webhook Verification) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Resend (Transactional Emails) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Beevo <hello@beevo.app>

# --- Background Render Worker (Railway Persistent Service) ---
BEEVO_WORKER_ID=railway-worker-1
BEEVO_WORKER_SHARED_SECRET=replace-with-strong-random-32-byte-hex
BEEVO_WORKER_CONCURRENCY=2
BEEVO_WORKER_POLL_MS=3000
BEEVO_WORKER_LEASE_SECONDS=300
BEEVO_MAX_SCENES_PER_PROJECT=160
BEEVO_MAX_ASSETS_PER_PROJECT=200
BEEVO_IMAGE_CONCURRENCY=4
BEEVO_IMAGE_MAX_RETRIES=2
BEEVO_USD_TO_INR_RATE=84.50
PORT=8080
