# ---------------------------------------------------------------------------
# Beevo — environment definitions (single source of truth)
# Copy to .env / .env.local (or Vercel Environment Variables) and fill values.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL / Supabase Database ---
# Leave DATABASE_URL empty in development to boot an in-process PostgreSQL
# (PGlite) with the repository migrations + seed applied automatically.
# Set it to true to disable that development fallback.
# BEEVO_DISABLE_DEV_DB=false
# For Supabase Pooler (IPv4 compatible), use your Session/Transaction pooler URI:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- App URL & Session Security (required in production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_USE_MOCKS is retired — the app always uses the live backend.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Razorpay Payments ---
# Accepts either NEXT_PUBLIC_RAZORPAY_KEY_ID or RAZORPAY_KEY_ID.
# IMPORTANT: RAZORPAY_KEY_SECRET must be the separate Secret generated alongside the Key ID (never equal to Key ID).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to true ONLY after Razorpay approves live centralized platform collections:
PAYMENTS_LIVE_ENABLED=false

# --- Resend Transactional Email (checkout OTP codes, verification, password
# reset, receipts, and the learner dashboard credentials sent after purchase).
# Required in production: without it, checkout falls back to showing the
# one-time code/password in the browser instead of emailing it. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Beevo <hello@beevo.in>"

# --- Cloudflare R2 Storage (course covers, videos, downloadable resources) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom public domain if configured; leave empty to use server-authorized access:
R2_PUBLIC_BASE_URL=
# Bucket CORS (Cloudflare dashboard → R2 → <bucket> → Settings → CORS policy) must allow
# the app origin so the browser can PUT/GET media directly (POST is required for multipart):
#   { "CORSRules": [{ "AllowedOrigins": ["https://your-app.com", "http://localhost:3000"],
#     "AllowedMethods": ["GET","PUT","POST","HEAD","DELETE"],
#     "AllowedHeaders": ["content-type","x-amz-content-sha256","*"],
#     "ExposeHeaders": ["ETag"], "MaxAgeSeconds": 3600 }] }
# Small uploads can fall back to the server-side relay (/api/v1/uploads/put/:id, ≤20 MB).
# Large videos/resources use direct R2 multipart uploads (16 MiB parts); CORS must expose
# ETag as shown above so the browser can complete them. File bytes never pass through the app.
